the details page the filing type will be selected\r\n        // This will filter the data after the widget loads to show the correct filings\r\n        if ($('#SecFilingType option:selected').val().length) {\r\n            $widget.sec('option', 'filingTypes', $('#SecFilingType option:selected').val().split(','));\r\n            $widget.sec('reloadItems');\r\n        }\r\n    }\r\n});\r\n</script>\n        </div>\n    </div>\n</div></span></span></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"pane pane--right\">\n            <div class=\"pane_inner\"><span class='RightPaneDiv'></span></div>\n        </div>\n        <div class=\"layout_footer\" role=\"contentinfo\">\n            <div class=\"pane pane--footer\">\n                <div class=\"pane_inner\"><span class='FooterPaneDiv'></span></div>\n            </div>\n            <div class=\"pane pane--footer2 background--alt-brand dark\">\n                <div class=\"pane_inner grid--no-gutter\"><span class='FooterPane2Div10'><div id=\"_ctrl0_ctl33_divModuleContainer\" class=\"module module-html module-logo grid_col grid_col--1-of-3 grid_col--md-1-of-1\" data-workflow-id=\"a13a1aab-5a75-4732-b1f4-f41ced5df0f8\">\n    <div class=\"module_container module_container--outer\">\n        \n        <div class=\"module_container module_container--inner\">\n            <a href=\"https://www.aboutamazon.com/\"><img src=\"//s2.q4cdn.com/299287126/files/design/amazon-logo-white.svg\" alt=\"About Amazon logo\"></a>\n        </div>\n    </div>\n</div></span><span class='FooterPane2Div11'><div id=\"_ctrl0_ctl36_RightBlock\" class=\"hidden\"></div>\n<div id=\"_ctrl0_ctl36_divModuleContainer\" class=\"module module-links module-links--social list--reset text-center grid_col grid_col--1-of-3 grid_col--md-1-of-1\" data-workflow-id=\"366c9eaa-55d2-4074-99fa-7ed0aed3816e\">\n    <div class=\"module_container module_container--outer\">\n        \n        <div class=\"mod